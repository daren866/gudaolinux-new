# ============================================================
#  Gudao Linux — kernel config fragment
#  Applied on top of x86_64 defconfig via scripts/kconfig/merge_config.sh
# ============================================================

# ---- Gudao branding ----
CONFIG_LOCALVERSION="-gudao"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="gudao"

# ---- initramfs (BusyBox terminal lives here) ----
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ---- console / TTY ----
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---- basic keyboard: AT/PS2 via i8042 ----
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_KEYBOARD_ATKBD=y

# ---- USB keyboard (VMs / modern hardware) ----
CONFIG_USB=y
CONFIG_HID=y
CONFIG_HID_SUPPORT=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y

# ---- network: Intel e1000 NIC built-in (QEMU default NIC) ----
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_E1000=y
CONFIG_E1000E=y

# ---- pseudo filesystems required by busybox init ----
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---- optional but handy for a live system ----
CONFIG_EXT4_FS=y
CONFIG_ISO9660_FS=y

# ---- build sanity (avoid pahole dependency) ----
# CONFIG_DEBUG_INFO_BTF is not set
