# ============================================================
#  Gudao Linux — kernel config fragment
#  Applied on top of x86_64 defconfig via scripts/kconfig/merge_config.sh
# ============================================================

# ---- Gudao branding ----
CONFIG_LOCALVERSION="-gudao"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="gudao"

# ---- initramfs (BusyBox terminal lives here) ----
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ---- console / TTY ----
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---- basic keyboard: AT/PS2 via i8042 ----
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_KEYBOARD_ATKBD=y

# ---- USB keyboard (VMs / modern hardware) ----
CONFIG_USB=y
CONFIG_HID=y
CONFIG_HID_SUPPORT=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y

# ---- network: Intel e1000 NIC built-in (QEMU default NIC) ----
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_E1000=y
CONFIG_E1000E=y

# ---- graphics: KMS drivers for QEMU / VMware / VirtualBox ----
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_BOCHS=y            # QEMU -vga std (default)
CONFIG_DRM_CIRRUS_QEMU=y      # QEMU -vga cirrus
CONFIG_DRM_QXL=y              # QEMU -vga qxl (virt-manager / SPICE default)
CONFIG_DRM_VIRTIO_GPU=y       # QEMU virtio-vga / -device virtio-gpu
CONFIG_HYPERVISOR_GUEST=y     # x86 dependency of DRM_VMWGFX
CONFIG_DRM_VMWGFX=y           # VMware SVGA II (also VirtualBox VMSVGA)
CONFIG_DRM_VBOXVIDEO=y        # VirtualBox VBoxVGA

# ---- firmware framebuffer fallback: any VM whose GPU has no KMS driver
#      still gets card0 + fb0 from the bootloader's VESA/EFI framebuffer ----
CONFIG_DRM_SIMPLEDRM=y        # KMS driver over the firmware framebuffer
CONFIG_SYSFB_SIMPLEFB=y       # expose VBE/EFI framebuffer to simpledrm
CONFIG_FB=y
CONFIG_FB_VESA=y              # legacy vesafb (fb0) fallback
CONFIG_FB_EFI=y               # legacy efifb (fb0) fallback, UEFI boots
CONFIG_FRAMEBUFFER_CONSOLE=y  # console on framebuffer (gfx payload boots)

# ---- mouse: VMware vmmouse (VBox/QEMU mouse via USB HID / PS/2) ----
CONFIG_MOUSE_PS2_VMMOUSE=y

# ---- X11 runtime needs ----
CONFIG_SYSVIPC=y
CONFIG_UNIX=y

# ---- pseudo filesystems required by busybox init ----
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---- optional but handy for a live system ----
CONFIG_EXT4_FS=y
CONFIG_ISO9660_FS=y

# ---- build sanity (avoid pahole dependency) ----
# CONFIG_DEBUG_INFO_BTF is not set
