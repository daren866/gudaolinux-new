# =============================================================
# Gudao Linux kernel config fragment (merged onto x86_64_defconfig)
# Merged by: scripts/kconfig/merge_config.sh
# =============================================================

# ---- Identity: Gudao Linux -----------------------------------
CONFIG_LOCALVERSION="-gudao"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="gudao"

# ---- Virtual terminal / VGA console (needed for shell input) --
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# ---- Basic keyboard: PS/2 (i8042 + AT keyboard) ---------------
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y

# ---- Basic keyboard: USB --------------------------------------
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_COMMON=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y

# ---- Serial console (debugging / QEMU smoke test) -------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---- initramfs / devtmpfs --------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# ---- Fast CI build: no debug info / no BTF / no modules -------
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_MODULES is not set
